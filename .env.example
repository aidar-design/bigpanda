# Copy this file to .env and fill in the values.
# On PaaS (Railway / Render / Heroku) put these in the platform's env-var UI instead.

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

DEBUG=False

# Comma-separated. Add the host the PaaS gives you.
# Example for Railway:  bigpanda.up.railway.app
# Example for Render:   bigpanda.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection URL (the PaaS provides this when you add a Postgres service).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://user:password@localhost:5432/bigpanda
